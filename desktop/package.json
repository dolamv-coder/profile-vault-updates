{
  "name": "profile-vault",
  "productName": "Orbit",
  "version": "1.9.49",
  "description": "Orbit: encrypted checkout profiles and order tracking",
  "main": "main.js",
  "author": "Orbit",
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "electron": "^33.4.11"
  },
  "dependencies": {
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.28"
  },
  "scripts": {
    "start": "electron .",
    "build:win": "electron-packager . \"Orbit\" --platform=win32 --arch=x64 --out=dist --overwrite --asar --prune=true --ignore=\"^/(dist|release|keys|tools|updates-repo|share-build|\\.claude)\"",
    "keygen": "node tools/release.mjs keygen",
    "release": "node tools/release.mjs publish"
  }
}
